{
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "property_id",
          "title",
          "street_address",
          "city",
          "state",
          "zip_code",
          "price",
          "bedrooms",
          "bathrooms",
          "square_feet",
          "property_type",
          "description",
          "listing_status",
          "image_src",
          "image_alt",
          "details_href",
          "amenities",
          "local_sponsors"
        ],
        "properties": {
          "property_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "street_address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip_code": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "bedrooms": {
            "type": "integer",
            "minimum": 0
          },
          "bathrooms": {
            "type": "number",
            "minimum": 0
          },
          "square_feet": {
            "type": "integer",
            "minimum": 1
          },
          "property_type": {
            "type": "string",
            "enum": [
              "single-family",
              "townhome",
              "condominium",
              "apartment",
              "cottage"
            ]
          },
          "description": {
            "type": "string"
          },
          "listing_status": {
            "type": "string",
            "enum": [
              "available",
              "pending",
              "sold"
            ]
          },
          "image_src": {
            "type": "string"
          },
          "image_alt": {
            "type": "string"
          },
          "details_href": {
            "type": "string"
          },
          "amenities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "accessible-entry",
                "air-conditioning",
                "balcony",
                "community-garden",
                "garage",
                "hardwood-floors",
                "laundry",
                "patio",
                "pool",
                "solar-panels"
              ]
            }
          },
          "local_sponsors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sponsor_id",
                "display_priority"
              ],
              "properties": {
                "sponsor_id": {
                  "type": "string"
                },
                "display_priority": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "records"
  ]
}
