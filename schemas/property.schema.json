{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/property.schema.json",
  "title": "Property",
  "description": "Contract for one synthetic property listing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "title",
    "street_address",
    "city",
    "state",
    "zip_code",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "property_type",
    "description",
    "listing_status",
    "image_src",
    "image_alt",
    "details_href",
    "amenities",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^property-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "street_address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.5
    },
    "square_feet": {
      "type": "integer",
      "minimum": 1
    },
    "property_type": {
      "type": "string",
      "enum": [
        "single-family",
        "townhome",
        "condominium",
        "apartment",
        "cottage"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "available",
        "pending",
        "sold"
      ]
    },
    "image_src": {
      "type": "string",
      "minLength": 1
    },
    "image_alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "details_href": {
      "type": "string",
      "format": "uri"
    },
    "amenities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "accessible-entry",
          "air-conditioning",
          "balcony",
          "community-garden",
          "garage",
          "hardwood-floors",
          "laundry",
          "patio",
          "pool",
          "solar-panels"
        ]
      }
    },
    "local_sponsors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sponsor_id",
          "display_priority"
        ],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^sponsor-[a-z0-9-]+$"
          },
          "display_priority": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}